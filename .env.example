# --- LLM -------------------------------------------------------------------
# "anthropic" (default) or "openai-compatible"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Any Claude model id. Triage is a small extraction task; measure a cheaper tier for your volume.
TRIAGE_MODEL=claude-opus-5-5

# Only for LLM_PROVIDER=openai-compatible
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Microsoft Teams (chat source) -----------------------------------------
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
# Only for confidential clients; leave empty for the usual public-client device-code setup.
TEAMS_CLIENT_SECRET=
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
# User id(s) of the account the gate signs in as, comma-separated.
TEAMS_SELF_USER_IDS=

# --- GitHub (issue tracker) ------------------------------------------------
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
# Deployment environment whose URL is offered as the preview. Default: Preview
GITHUB_PREVIEW_ENVIRONMENT=

# --- Behaviour -------------------------------------------------------------
# Where tickets and the Teams refresh token are stored (JSON files).
STORE_DIR=.triage-gate
# Both default to off: reading and judging never writes anywhere external.
AUTO_REPLY=0
AUTO_ISSUE=0
# Shown to the model so it knows what it is triaging for.
PRODUCT_NAME=
# Comma-separated product areas the model may assign (anything else becomes "unknown").
AREAS=web,api,billing,infra
# Comma-separated host suffixes a preview link must match before it is posted to a reporter.
PREVIEW_HOSTS=
# Comma-separated bracket tags that mark a "we shipped X" announcement in the channel.
ANNOUNCEMENT_TAGS=SHIPPED,RELEASED,FIXED
